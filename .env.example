# Copy this file to ".env" and edit the values.

# Location for the weather forecast (latitude / longitude).
# Default below is the Tokyo Station area — set your own.
LAT=35.6812
LON=139.7671

# Time zone of the dashboard (IANA name).
TZ=Asia/Tokyo

# Host port the dashboard is served on (http://<host>:<port>/dashboard.png).
HOST_PORT=8080

# How often the image is regenerated, in seconds.
GENERATE_INTERVAL=1800

# Fallback weather source settings (only used if Open-Meteo is unreachable).
# WTTR_LOCATION is a wttr.in location name; JMA_AREA_CODE is a Japan
# Meteorological Agency area code (130000 = Tokyo). The JMA fallback is
# Japan-specific; outside Japan the weekly strip may be incomplete.
WTTR_LOCATION=Tokyo
JMA_AREA_CODE=130000

# Screen size of the target Kindle. Paperwhite 3 (7th gen) is 1072x1448;
# the layout is tuned for this size.
#SCREEN_W=1072
#SCREEN_H=1448
